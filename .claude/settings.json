{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr create*)",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/ingame-gate.mjs\"",
            "timeout": 30,
            "statusMessage": "In-game gate: checking the test verdict for this PR"
          }
        ]
      }
    ]
  }
}
